const DIFFICULTIES := {
	"standard": {"name": "Combate", "damage": 0.8, "speed": 0.82, "reaction": 1.35},
	"challenging": {"name": "Desafío", "damage": 1.0, "speed": 1.0, "reaction": 1.0},
	"expert": {"name": "Experto", "damage": 1.2, "speed": 1.14, "reaction": 0.72},
}
const DIFFICULTY_ORDER := ["standard", "challenging", "expert"]

static var _color_cache: Dictionary = {}


static func fighter(id: String) -> Dictionary:
	for entry in FIGHTERS:
		if entry["id"] == id:
			return entry
	push_error("Luchador desconocido: %s" % id)
	return FIGHTERS[0]


static func has_fighter(id: String) -> bool:
	for entry in FIGHTERS:
		if entry["id"] == id:
			return true
	return false


static func fighter_index(id: String) -> int:
	for i in range(FIGHTERS.size()):
		if FIGHTERS[i]["id"] == id:
			return i
	return -1


static func stage(id: String) -> Dictionary:
	for entry in STAGES:
		if entry["id"] == id:
			return entry
	return STAGES[0]


static func difficulty(id: String) -> Dictionary:
	if DIFFICULTIES.has(id):
		return DIFFICULTIES[id]
	return DIFFICULTIES["challenging"]


## Convierte "#rrggbb" en Color y lo guarda en caché.
static func color(hex: String) -> Color:
	if not _color_cache.has(hex):
		_color_cache[hex] = Color(hex)
	return _color_cache[hex]
