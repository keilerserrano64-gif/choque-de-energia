; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Choque de Energía"
config/description="Juego de pelea 2D en pixel art con ocho luchadores, VS local y arcade."
config/version="3.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.047, 0.059, 0.09, 1)
config/icon="res://icon.svg"

[autoload]

SaveData="*res://scripts/autoload/save_data.gd"
Sfx="*res://scripts/autoload/audio_manager.gd"
Controls="*res://scripts/autoload/controls.gd"
Router="*res://scripts/autoload/router.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.059, 0.09, 1)
